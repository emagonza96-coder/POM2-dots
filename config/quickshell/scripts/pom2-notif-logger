#!/usr/bin/env python3
import os
import sys
import json
import time

NOTIF_FILE = f"/run/user/{os.getuid()}/pom2-notifications.json"

def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""

    if action == "--clear":
        try:
            with open(NOTIF_FILE, "w", encoding="utf-8") as f:
                json.dump([], f)
        except Exception:
            pass
        return

    if action == "--get":
        if os.path.exists(NOTIF_FILE):
            try:
                with open(NOTIF_FILE, "r", encoding="utf-8") as f:
                    sys.stdout.write(f.read())
                    return
            except Exception:
                pass
        sys.stdout.write("[]")
        return

    # Invocado por SwayNC con variables de entorno
    app_name = os.environ.get("SWAYNC_APP_NAME", "").strip() or "Sistema"
    summary = os.environ.get("SWAYNC_SUMMARY", "").strip()
    body = os.environ.get("SWAYNC_BODY", "").strip()
    time_str = time.strftime("%H:%M:%S")
    urgency = os.environ.get("SWAYNC_URGENCY", "normal").lower()
    notif_id = os.environ.get("SWAYNC_ID", str(int(time.time() * 1000)))

    if not summary and not body:
        return

    notifs = []
    if os.path.exists(NOTIF_FILE):
        try:
            with open(NOTIF_FILE, "r", encoding="utf-8") as f:
                notifs = json.load(f)
        except Exception:
            notifs = []

    # Insertar al inicio de la lista
    notifs.insert(0, {
        "id": notif_id,
        "app": app_name,
        "summary": summary,
        "body": body,
        "time": time_str,
        "urgency": urgency
    })

    # Conservar hasta 30 notificaciones
    notifs = notifs[:30]

    tmp = f"{NOTIF_FILE}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(notifs, f, ensure_ascii=False)
        os.replace(tmp, NOTIF_FILE)
    except Exception:
        pass

if __name__ == "__main__":
    main()
