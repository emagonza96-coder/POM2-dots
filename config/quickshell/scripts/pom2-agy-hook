#!/usr/bin/env python3
import sys
import os
import json
import time
import subprocess

STATE_PATH = f"/run/user/{os.getuid()}/pom2-agent.json"

def get_current_data():
    if os.path.exists(STATE_PATH):
        try:
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            pass
    return {
        "state": "idle",
        "tool": "",
        "category": "STANDBY",
        "icon": "󰍛",
        "target": "",
        "detail": "",
        "history": [],
        "active": False,
        "call_count": 0,
        "files_modified": [],
        "session_start": time.time(),
        "last_updated": time.time()
    }

def save_data(data):
    data["last_updated"] = time.time()
    tmp_path = f"{STATE_PATH}.tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp_path, STATE_PATH)
    except Exception:
        pass

def main():
    event = sys.argv[1] if len(sys.argv) > 1 else ""

    if event == "--reset":
        data = {
            "state": "idle",
            "tool": "",
            "category": "STANDBY",
            "icon": "󰍛",
            "target": "Sin operación activa",
            "detail": "Esperando instrucciones del usuario",
            "history": [],
            "active": False,
            "call_count": 0,
            "files_modified": [],
            "session_start": time.time(),
            "last_updated": time.time()
        }
        save_data(data)
        print("{}")
        return

    raw_input = ""
    try:
        if not sys.stdin.isatty():
            raw_input = sys.stdin.read()
    except Exception:
        pass

    payload = {}
    if raw_input.strip():
        try:
            payload = json.loads(raw_input)
        except Exception:
            payload = {}

    data = get_current_data()
    now_str = time.strftime("%H:%M:%S")

    if event == "PreInvocation":
        data["state"] = "thinking"
        data["active"] = True
        data["tool"] = "inference"
        data["category"] = "INFERENCE"
        data["icon"] = "󰈈"
        data["target"] = "Analizando solicitud..."
        data["detail"] = "Procesando contexto de la tarea y evaluando siguientes acciones."
        save_data(data)
        print("{}")
        return

    elif event == "PreToolUse":
        tool_call = payload.get("toolCall", {})
        tool_name = tool_call.get("name", "tool")
        args = tool_call.get("args", {})

        target = ""
        detail = ""
        category = "TOOL"
        icon = "󰍛"

        if tool_name == "run_command":
            cmd = args.get("CommandLine", "").strip()
            category = "EXEC // SHELL"
            icon = "󰞷"
            target = cmd[:45] + ("..." if len(cmd) > 45 else "")
            detail = cmd
        elif tool_name in ("replace_file_content", "multi_replace_file_content"):
            fpath = args.get("TargetFile", "")
            fname = os.path.basename(fpath) if fpath else "archivo"
            category = "CODE // EDIT"
            icon = "󰏫"
            target = fname
            detail = args.get("Description", fpath)
            # Registrar archivo modificado
            files = data.get("files_modified", [])
            if fname and fname not in files:
                files.append(fname)
            data["files_modified"] = files[-10:]
        elif tool_name == "write_to_file":
            fpath = args.get("TargetFile", "")
            fname = os.path.basename(fpath) if fpath else "archivo"
            category = "FILE // CREATE"
            icon = "󰈔"
            target = fname
            detail = args.get("Description", fpath)
            files = data.get("files_modified", [])
            if fname and fname not in files:
                files.append(fname)
            data["files_modified"] = files[-10:]
        elif tool_name == "view_file":
            fpath = args.get("AbsolutePath", "")
            category = "READ // INSPECT"
            icon = "󰈙"
            target = os.path.basename(fpath) if fpath else "archivo"
            detail = fpath
        elif tool_name in ("grep_search", "list_dir"):
            category = "SEARCH // FS"
            icon = "󰍉"
            q = args.get("Query", "") or args.get("DirectoryPath", "")
            target = f"buscar '{q[:25]}'"
            detail = q
        elif tool_name in ("search_web", "read_url_content"):
            category = "WEB // NET"
            icon = "󰖟"
            q = args.get("query", "") or args.get("Url", "")
            target = f"web '{q[:25]}'"
            detail = q
        elif tool_name == "ask_question":
            category = "USER // INPUT"
            icon = "󰘥"
            target = "Cuestionario de usuario"
            detail = "Esperando decisión del usuario"
        else:
            category = "TOOL // CUSTOM"
            icon = "󰍛"
            target = tool_name
            detail = str(args)[:60]

        data["state"] = "working"
        data["active"] = True
        data["tool"] = tool_name
        data["category"] = category
        data["icon"] = icon
        data["target"] = target
        data["detail"] = detail
        data["call_count"] = data.get("call_count", 0) + 1

        history = data.get("history", [])
        history.insert(0, {
            "time": now_str,
            "tool": tool_name,
            "category": category.split(" // ")[0],
            "icon": icon,
            "target": target,
            "status": "running"
        })
        data["history"] = history[:8]
        save_data(data)

        # PreToolUse requiere decision: allow
        print(json.dumps({"decision": "allow"}))
        return

    elif event == "PostToolUse":
        history = data.get("history", [])
        if history:
            err = payload.get("error")
            if err:
                history[0]["status"] = "error"
            else:
                history[0]["status"] = "ok"
            data["history"] = history
        save_data(data)
        print("{}")
        return

    elif event == "Stop":
        data["state"] = "finished"
        data["active"] = False
        data["tool"] = "idle"
        data["category"] = "STANDBY"
        data["icon"] = "󰄬"
        data["target"] = "Tarea completada"
        data["detail"] = "Sesión finalizada. En espera de nuevas instrucciones."
        save_data(data)

        try:
            subprocess.Popen([
                "notify-send",
                "POM-2 // AGENT",
                "Tarea completada con éxito",
                "-a", "Antigravity",
                "-u", "normal",
                "-i", "terminal"
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

        print("{}")
        return

    print("{}")

if __name__ == "__main__":
    main()
